{
  "compilerOptions": {
    "target": "ES2020",                  // Modern JS output
    "module": "CommonJS",                // Node compatible
    "outDir": "dist",                    // Compiled JS goes here
    "rootDir": ".",                      // Root folder for TS source
    "strict": true,                      // Enable strict type checking
    "esModuleInterop": true,             // Allows default imports
    "forceConsistentCasingInFileNames": true,
    "skipLibCheck": true,                // Skip type checks for node_modules
    "resolveJsonModule": true
  },
  "include": [
    "server.ts",
    "services/**/*.ts",
    "models/**/*.ts"
  ],
  "exclude": [
    "node_modules",
    "dist"
  ]
}
