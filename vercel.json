{
  "version": 2,
  "builds": [
    {
      "src": "package.json",
      "use": "@vercel/static-build",
      "config": {
        "distDir": "dist"
      }
    },
    {
      "src": "backend/server.ts",
      "use": "@vercel/node"
    }
  ],
  "routes": [
    {
      "src": "/api/(.*)",
      "dest": "/backend/server.ts"
    },

    {
      "src": "/qubi/(.*)",
      "dest": "/qubi/$1"
    },

    {
      "src": "/assets/(.*)",
      "dest": "/assets/$1"
    },

    {
      "src": "/favicon.ico",
      "dest": "/favicon.ico"
    },

    {
      "src": "/robots.txt",
      "dest": "/robots.txt"
    },

    {
      "handle": "filesystem"
    },

    {
      "src": "/(.*)",
      "dest": "/index.html"
    }
  ]
}